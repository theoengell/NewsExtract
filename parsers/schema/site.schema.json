{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsextract.local/schemas/site.schema.json",
  "title": "NewsExtract site grammar",
  "type": "object",
  "required": ["id", "name", "url", "language", "domains", "strategies"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fetch_timeout": { "type": "integer", "minimum": 1 },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/strategy" }
    }
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["card", "link_scan", "heading_scan", "select"]
        },
        "container": { "type": "string" },
        "match": { "type": "string" },
        "title": {},
        "link": {},
        "link_fallback": { "type": "string" },
        "score": { "type": "number" },
        "href_must": { "type": "array", "items": { "type": "string" } },
        "href_skip": { "type": "array", "items": { "type": "string" } },
        "href_skip_endswith": { "type": "array", "items": { "type": "string" } },
        "min_length": { "type": "integer", "minimum": 0 },
        "max_length": { "type": ["integer", "null"], "minimum": 0 },
        "text_drop_prefix": { "type": "array", "items": { "type": "string" } },
        "text_drop_regex": { "type": "array", "items": { "type": "string" } },
        "class_hint": { "type": "boolean" },
        "soft_min_length": { "type": "integer", "minimum": 0 },
        "soft_score": { "type": "number" },
        "score_recipe": { "type": "string" },
        "require_link": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "card" } } },
          "then": { "required": ["container", "title"] }
        }
      ]
    }
  }
}
